# Copy to .env and change as needed.

# Optional. The values below are the defaults.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Required. Matches the db service in compose.yaml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meeting_scheduler

# Required, at least 32 characters. Local values only; make new ones for any
# real deployment with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-only-better-auth-secret-0000000000
API_SECRET=local-only-api-secret-000000000000000000
